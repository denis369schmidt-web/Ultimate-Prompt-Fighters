static func for_family(family: String) -> Dictionary:
	return KITS.get(family, {})

## Movement values of a profile: the defaults merged with the fighter's kit.
static func physics(p: Dictionary) -> Dictionary:
	var phys: Dictionary = DEFAULT_PHYS.duplicate()
	phys.merge(for_family(str(p.get("family", ""))).get("phys", {}), true)
	return phys

static func finisher(family: String) -> Dictionary:
	return for_family(family).get("finisher", {})

static func archetype(family: String) -> String:
	return str(for_family(family).get("archetype", ""))
