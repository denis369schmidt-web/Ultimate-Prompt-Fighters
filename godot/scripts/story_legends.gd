## Boss ids above that are not real bosses fall back to these.
const BOSS_FALLBACK := {"hell_gate_boss": "ahriman", "hell_flames_boss": "baphomet", "cocytus_boss": "lucifer", "cerberus_alias": "asmodeus"}

static func has_legend(fam: String) -> bool:
	return LEGENDS.has(fam)

## Hand-written legend of a fighter (scripts/legends/legend_<id>.gd), or null: then the short
## generic legend built from LEGENDS is used.
static func individual(fam: String):
	var path := "res://scripts/legends/legend_%s.gd" % fam
	return load(path) if ResourceLoader.exists(path) else null

static func info(fam: String) -> Dictionary:
	var ind = individual(fam)
	if ind != null: return ind.INFO
	var L: Array = LEGENDS[fam]
	return {"epithet": L[3], "summary": L[4], "relic": "Erbe von " + cast_name(fam)}

static func boss_of(fam: String) -> String:
	var b: String = LEGENDS[fam][2]
	return BOSS_FALLBACK.get(b, b)

## Stars needed for chapter k (0..3).
static func stars_needed(k: int) -> int:
	return STARS[clampi(k, 0, 3)]

static func _say(who: String, text: String) -> Dictionary:
	return {"t": "say", "who": who, "text": text}

static func _narr(text: String) -> Dictionary:
	return {"t": "narrate", "text": text}

static func _cam(shot: String, who: int = 0, time: float = 1.6, who2: int = 1) -> Dictionary:
	return {"t": "cam", "shot": shot, "who": who, "who2": who2, "time": time}

static func _stage(cast: Array) -> Dictionary:
	var c: Array = []
	for e in cast: c.append({"id": e[0], "x": e[1], "facing": e[2]})
	return {"t": "stage", "cast": c}

static func _pose(who: int, pose: String, time: float = 0.8) -> Dictionary:
	return {"t": "pose", "who": who, "pose": pose, "time": time}

static func _music(mood: String) -> Dictionary:
	return {"t": "music", "mood": mood}

## Cast of one legend: the hero, the rival, the abyss boss and the hero's shadow.
static func cast(fam: String, presets: Array) -> Dictionary:
	var ind = individual(fam)
	if ind != null:
		# "preset": roster id -> that fighter's prompt (so every story fighter is a real fighter).
		var out := {}
		for key in ind.CAST:
			var c: Dictionary = ind.CAST[key].duplicate()
			if c.has("preset"):
				for p in presets:
					if str(p.id) == str(c.preset): c["prompt"] = str(p.prompt)
			if not c.has("prompt"): c["prompt"] = ""
			out[key] = c
		return out
	var L: Array = LEGENDS[fam]
	var by_id := {}
	for p in presets: by_id[str(p.id)] = p
	var me: Dictionary = by_id.get(fam, {"name": fam.to_upper(), "prompt": fam})
	var rv: Dictionary = by_id.get(str(L[1]), by_id.get("ninja", {"name": "RIVALE", "prompt": "Crimson Schattenninja mit roten Klingen"}))
	return {
		"hero": {"name": str(me.name), "title": str(L[3]), "color": "fde68a", "prompt": str(me.prompt)},
		"rival": {"name": str(rv.name), "title": "Rivale", "color": "f87171", "prompt": str(rv.prompt)},
		"abyss": {"name": str(Bosses_name(boss_of(fam))), "title": "Der Abgrund", "color": "ff3b5c", "prompt": "", "boss": boss_of(fam)},
		"shadow": {"name": "SCHATTEN-" + str(me.name), "title": "Was du verschweigst", "color": "a855f7", "prompt": str(me.prompt)},
	}

static func Bosses_name(bid: String) -> String:
	var d: Dictionary = load("res://scripts/bosses.gd").data(bid)
	return str(d.get("name", bid.to_upper()))

## The four chapters of a legend, with short cinematics before and after every fight.
static func chapters(fam: String) -> Array:
	var ind = individual(fam)
	if ind != null: return ind.chapters()
	var L: Array = LEGENDS[fam]
	var home: String = L[0]
	var list: Array = []
	list.append({"id": fam + "_1", "title": CHAPTER_NAMES[0], "arena": home, "stars": 0, "steps": [
		_stage([["hero", -1.5, 1], ["rival", 9.0, -1]]),
		{"t": "vanish", "who": 1},
		_music("calm"),
		_cam("sky", 0, 0.01),
		{"t": "title", "text": "LEGENDE · " + str(L[3]).to_upper(), "sub": "Kapitel I – " + CHAPTER_NAMES[0]},
		_narr(L[4]),
		_cam("low", 0, 2.2),
		_pose(0, "Idle", 0.4),
		_narr(L[5]),
		_cam("close", 0, 1.4),
		_say("hero", L[6]),
		_pose(0, "Victory", 1.0),
		{"t": "fx", "kind": "flash"},
		{"t": "appear", "who": 1},
		{"t": "move", "who": 1, "x": 2.2, "time": 1.0},
		_cam("two", 0, 1.2, 1),
		_say("rival", "Ich habe von dir gehört. Mal sehen, ob die Geschichten stimmen."),
		_music("fight"),
		{"t": "fight", "cast": ["hero", "rival"], "goal": "ZEIG, WER DU BIST!", "lives": [2, 1]},
		_music("hope"),
		_cam("two", 0, 1.2, 1),
		_say("rival", "Nicht schlecht … Wir sehen uns wieder. Dann ohne Zurückhaltung."),
		{"t": "move", "who": 1, "x": 9.0, "time": 1.0},
		_cam("close", 0, 1.2),
		_narr("Die Geschichte von " + str(cast_name(fam)) + " hat gerade erst begonnen."),
	]})
	list.append({"id": fam + "_2", "title": CHAPTER_NAMES[1], "arena": home, "stars": 1, "steps": [
		_stage([["hero", -2.0, 1], ["rival", 2.0, -1]]),
		_music("tense"),
		_cam("wide", 0, 0.01),
		{"t": "title", "text": "KAPITEL II", "sub": CHAPTER_NAMES[1]},
		_cam("two", 0, 1.8, 1),
		_say("rival", L[7]),
		_cam("close", 0, 1.0),
		_pose(0, "Charge", 1.0),
		_say("hero", L[6]),
		{"t": "fx", "kind": "shake"},
		_music("fight"),
		{"t": "fight", "cast": ["hero", "rival"], "goal": "BESIEGE DEINEN RIVALEN!", "lives": [2, 2]},
		_music("calm"),
		_cam("two", 1, 1.4, 0),
		_pose(1, "HitReact", 0.6),
		_say("rival", "… Du hast dich verändert. Pass auf dich auf. Da unten wartet etwas Schlimmeres als ich."),
		_narr("Etwas regt sich unter der Arena. Etwas, das " + str(cast_name(fam)) + " schon lange kennt."),
	]})
	list.append({"id": fam + "_3", "title": CHAPTER_NAMES[2], "arena": home, "stars": 2, "steps": [
		_stage([["hero", -2.5, 1], ["abyss", 3.0, -1]]),
		{"t": "vanish", "who": 1},
		_music("tense"),
		_cam("low", 0, 0.01),
		{"t": "title", "text": "KAPITEL III", "sub": CHAPTER_NAMES[2]},
		_narr(L[8]),
		{"t": "fx", "kind": "ink", "who": 0},
		{"t": "appear", "who": 1},
		_cam("sky", 1, 2.4),
		_cam("close", 0, 1.2),
		_say("hero", "Ich weiß, was du willst. Du bekommst es nicht."),
		_music("boss"),
		{"t": "fight", "cast": ["hero", "abyss"], "goal": "BESTEHE DIE PRÜFUNG DES ABGRUNDS!", "lives": [3, 1]},
		_music("hope"),
		{"t": "fx", "kind": "flash"},
		_cam("close", 0, 1.6),
		_narr("Der Abgrund schließt sich. Aber in der Stille bleibt eine Stimme, die genauso klingt wie " + str(cast_name(fam)) + "."),
	]})
	list.append({"id": fam + "_4", "title": CHAPTER_NAMES[3], "arena": home, "stars": 3, "steps": [
		_stage([["hero", -2.0, 1], ["shadow", 2.0, -1]]),
		{"t": "vanish", "who": 1},
		_music("sad"),
		_cam("wide", 0, 0.01),
		{"t": "title", "text": "KAPITEL IV", "sub": CHAPTER_NAMES[3]},
		_cam("close", 0, 2.0),
		_narr("Am Ende jedes Weges wartet nur ein Gegner, den man nicht ausweichen kann."),
		{"t": "fx", "kind": "ink", "who": 0},
		{"t": "appear", "who": 1},
		_cam("two", 0, 1.6, 1),
		_say("shadow", L[9]),
		_pose(0, "Idle", 0.6),
		_say("hero", "Vielleicht. Aber ich bin trotzdem hier."),
		_music("boss_final"),
		{"t": "fight", "cast": ["hero", "shadow"], "goal": "STELL DICH DIR SELBST!", "lives": [2, 2]},
		# Ending cinematic.
		_music("hope"),
		{"t": "vanish", "who": 1},
		{"t": "fx", "kind": "flash"},
		_cam("low", 0, 2.4),
		_pose(0, "Victory", 1.2),
		_narr(L[10]),
		_cam("sky", 0, 3.0),
		{"t": "title", "text": "LEGENDE VOLLENDET", "sub": str(cast_name(fam)) + " · " + str(L[3])},
		_narr("Relikt erhalten: Erbe von " + str(cast_name(fam)) + "  ·  +%d Münzen  ·  Goldrahmen  ·  Legenden-Truhe" % RELIC_COINS),
	]})
	return list

static func cast_name(fam: String) -> String:
	return str(_NAMES.get(fam, fam.to_upper()))

