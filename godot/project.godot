config_version=5

[application]

config/quit_on_go_back=false
config/name="Prompt Fighter Ultimate"
config/version="0.9.0"
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.015, 0.024, 0.048, 1)
boot_splash/image="res://icon.png"
boot_splash/fullsize=false
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=4

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=4
environment/defaults/default_clear_color=Color(0.015,0.024,0.048,1)
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/directional_shadow/size.mobile=1024
lights_and_shadows/positional_shadow/atlas_size=2048
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_3d.mobile=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/screen_space_aa.mobile=1
anti_aliasing/quality/use_debanding=true

[physics]
common/physics_ticks_per_second=60
common/physics_interpolation=true
